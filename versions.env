# Pinned versions for the Dispatcharr FFmpeg image.
# Bump deliberately; keep NV_CODEC_HEADERS on the 13.0 line for Pascal / driver 580.
#
# FFmpeg releases: FFMPEG_SERIES is the major version (9.0.x and 9.1.x).
# .github/workflows/version-bump.yml opens a PR when a newer 9.x release appears.

FFMPEG_SERIES=9
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz

NV_CODEC_HEADERS_TAG=n13.0.19.0
NV_CODEC_HEADERS_URL=https://github.com/FFmpeg/nv-codec-headers/archive/refs/tags/n13.0.19.0.tar.gz

# Fedora/freedesktop AAC-LC-only fork (not full Fraunhofer FDK). Built static.
FDK_AAC_STRIPPED_TAG=stripped5
FDK_AAC_STRIPPED_URL=https://gitlab.freedesktop.org/wtaymans/fdk-aac-stripped/-/archive/stripped5/fdk-aac-stripped-stripped5.tar.gz

# Codecs compiled into ffmpeg (static .a only). Ubuntu -dev packages do not ship .a.
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55
X264_URL=https://code.videolan.org/videolan/x264/-/archive/b35605ace3ddf7c1a5d67a2eb553f034aef41d55/x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55.tar.gz
X265_VERSION=3.6
X265_URL=https://bitbucket.org/multicoreware/x265_git/get/Release_3.6.tar.gz
# 3.100 does not build with GCC 15. This is the Ubuntu 26 snapshot (3.101 beta).
LAME_VERSION=3.101~svn6525
LAME_URL=https://archive.ubuntu.com/ubuntu/pool/main/l/lame/lame_3.101~svn6525+dfsg.orig.tar.gz
OPUS_VERSION=1.5.2
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz
DAV1D_VERSION=1.5.1
DAV1D_URL=https://code.videolan.org/videolan/dav1d/-/archive/1.5.1/dav1d-1.5.1.tar.gz
LIBVPX_VERSION=1.15.2
LIBVPX_URL=https://github.com/webmproject/libvpx/archive/refs/tags/v1.15.2.tar.gz

UBUNTU_BASE=ubuntu:26.04
IMAGE_TAG_SUFFIX=nvenc130
