# Pinned versions for the Dispatcharr FFmpeg image.
# Bump deliberately; keep NV_CODEC_HEADERS on the 13.0 line for Pascal / driver 580.
#
# .github/workflows/version-bump.yml opens one PR per pin when a newer release
# (or branch tip) appears on the configured series / ref. Merge the PR, then
# run build.yml manually. Image builds are not triggered by bump PRs.
#
# FFmpeg: FFMPEG_SERIES is the major version (9.0.x and 9.1.x).
# NVENC headers: NV_CODEC_HEADERS_SERIES is the NVENC API line (MAJOR.MINOR).
# fdk-aac-stripped: tip of FDK_AAC_STRIPPED_REF (stripped5, not default stripped4).
# x264: tip of X264_REF (stable).
# x265 / Opus / dav1d / libvpx: newest release tag on the configured major series.
# LAME: newest Ubuntu pool orig tarball (GCC 15 needs newer than stock 3.100).

FFMPEG_SERIES=9
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz

NV_CODEC_HEADERS_SERIES=13.0
NV_CODEC_HEADERS_TAG=n13.0.19.1
NV_CODEC_HEADERS_URL=https://github.com/FFmpeg/nv-codec-headers/archive/refs/tags/n13.0.19.1.tar.gz

# Fedora/freedesktop AAC-LC-only fork (not full Fraunhofer FDK). Built static.
FDK_AAC_STRIPPED_REF=stripped5
FDK_AAC_STRIPPED_COMMIT=9896ddc0d08bb3f764f01d5e372bec1c068ad8f5
FDK_AAC_STRIPPED_URL=https://gitlab.freedesktop.org/wtaymans/fdk-aac-stripped/-/archive/9896ddc0d08bb3f764f01d5e372bec1c068ad8f5/fdk-aac-stripped-9896ddc0d08bb3f764f01d5e372bec1c068ad8f5.tar.gz

# Codecs compiled into ffmpeg as static .a and linked into the binary.
# Tip of master (stable lags). Point releases are not tagged upstream.
X264_REF=master
X264_COMMIT=0480cb05fa188d37ae87e8f4fd8f1aea3711f7ee
X264_URL=https://code.videolan.org/videolan/x264/-/archive/0480cb05fa188d37ae87e8f4fd8f1aea3711f7ee/x264-0480cb05fa188d37ae87e8f4fd8f1aea3711f7ee.tar.gz

X265_SERIES=4
X265_VERSION=4.2
X265_URL=https://bitbucket.org/multicoreware/x265_git/get/4.2.tar.gz

# Prefer Ubuntu pool orig tarballs. Stock 3.100 fails on GCC 15; 4.0 builds on 26.04.
LAME_VERSION=4.0
LAME_URL=https://archive.ubuntu.com/ubuntu/pool/main/l/lame/lame_4.0.orig.tar.gz

OPUS_SERIES=1
OPUS_VERSION=1.6.1
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz

DAV1D_SERIES=1
DAV1D_VERSION=1.5.4
DAV1D_URL=https://code.videolan.org/videolan/dav1d/-/archive/1.5.4/dav1d-1.5.4.tar.gz

LIBVPX_SERIES=1
LIBVPX_VERSION=1.17.0
LIBVPX_URL=https://github.com/webmproject/libvpx/archive/refs/tags/v1.17.0.tar.gz

UBUNTU_BASE=ubuntu:26.04
IMAGE_TAG_SUFFIX=nvenc130
