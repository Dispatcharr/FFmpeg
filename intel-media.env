# Intel free-kernel media stack (amd64 only).
# Kept separate from versions.env so Docker/GHA layer cache only rebuilds this
# stack when these pins (or scripts/build-intel-media.sh) change.
#
# Bump as one set from the same Intel media release train. Ubuntu 26.04's
# intel-media-va-driver / libmfx-gen are still 26.1.2 and break Arc hevc_qsv.
# These pins match intel-onevpl-26.3.5 / intel-media-26.3.5.
# ENABLE_NONFREE_KERNELS stays OFF (universe-equivalent free-kernel build).
# Not covered by version-bump.yml yet (coordinated pin).

LIBVA_VERSION=2.24.1
LIBVA_URL=https://github.com/intel/libva/archive/refs/tags/2.24.1.tar.gz

INTEL_GMMLIB_VERSION=22.10.2
INTEL_GMMLIB_URL=https://github.com/intel/gmmlib/archive/refs/tags/intel-gmmlib-22.10.2.tar.gz

INTEL_MEDIA_DRIVER_VERSION=26.3.5
INTEL_MEDIA_DRIVER_URL=https://github.com/intel/media-driver/archive/refs/tags/intel-media-26.3.5.tar.gz

LIBVPL_VERSION=2.17.0
LIBVPL_URL=https://github.com/intel/libvpl/archive/refs/tags/v2.17.0.tar.gz

VPL_GPU_RT_VERSION=26.3.5
VPL_GPU_RT_URL=https://github.com/intel/vpl-gpu-rt/archive/refs/tags/intel-onevpl-26.3.5.tar.gz
